APP_NAME=Mail

ENABLE_DEBUG=false
LOG_LEVEL=WARNING
LOG_FILE=

DB_CONNECTION_TYPE=host
DB_DRIVER=sqlite
DB_NAME=/var/lib/hm3/cypht.sqlite

SESSION_TYPE=custom
SESSION_CLASS=Local_Agent_Session
AUTH_TYPE=custom
AUTH_CLASS=Local_Agent_Auth

USER_CONFIG_TYPE=custom:Local_Agent_User_Config
USER_SETTINGS_DIR=/var/lib/hm3/users
ATTACHMENT_DIR=/var/lib/hm3/attachments

COOKIE_DOMAIN=none
COOKIE_PATH=/services/mail/
DISABLE_ORIGIN_CHECK=true
SINGLE_SERVER_MODE=false

ENABLE_REDIS=false
ENABLE_MEMCACHED=false

LOCAL_AGENT_AUTH_USERNAME=
LOCAL_AGENT_AUTH_PASSWORD=
API_LOGIN_KEY=

DEFAULT_LANGUAGE=zh-Hans
DEFAULT_SETTING_LANGUAGE=zh-Hans
DEFAULT_SETTING_TIMEZONE=Asia/Shanghai
DEFAULT_SETTING_NO_PASSWORD_SAVE=false

CYPHT_MODULES="core,contacts,local_contacts,feeds,jmap,imap,smtp,calendar,themes,nux,history,saved_searches,advanced_search,highlights,profiles,inline_message,imap_folders,keyboard_shortcuts,tags,sievefilters,scheduled_sends,site,api_login"
